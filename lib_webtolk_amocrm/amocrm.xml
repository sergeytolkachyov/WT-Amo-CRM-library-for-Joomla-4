<?xml version="1.0" encoding="UTF-8" ?>
<extension type="library" method="upgrade">
	<name>WebTolk AmoCRM library</name>
	<libraryname>Webtolk/Amocrm</libraryname>
	<version>1.3.0</version>
	<description>AmoCRM connection library</description>
	<creationDate>May 2025</creationDate>
	<copyright>2022-2025 Sergey Tolkachyov</copyright>
	<license>GNU/GPL 3.0</license>
	<author>Sergey Tolkachyov</author>
	<authorEmail>info@web-tolk.ru</authorEmail>
	<authorUrl>https://web-tolk.ru</authorUrl>
	<namespace path="src">Webtolk\Amocrm</namespace>
	<scriptfile>script.php</scriptfile>
	<files>
		<folder>src</folder>
		<folder>language</folder>
		<filename>amocrm.xml</filename>
		<filename>script.php</filename>
	</files>
	<languages folder="language">
		<language tag="ru-RU">ru-RU/lib_webtolk_amocrm.ini</language>
		<language tag="en-GB">en-GB/lib_webtolk_amocrm.ini</language>
	</languages>
	<layouts folder="layouts" destination="libraries/webtolk/amocrm">
		<folder>fields</folder>
	</layouts>
</extension>
